# Recomendado para PCs sin GPU dedicada (elige al menos uno):
CORTE_GEMINI_API_KEY=
# Alternativa gratuita en OpenRouter (ej. particle-ai/particle-1:free):
CORTE_OPENROUTER_API_KEY=

# Ajustes recomendados si NO tienes GPU dedicada (NVIDIA CUDA):
CORTE_WHISPER_DEVICE=cpu
CORTE_WHISPER_COMPUTE=int8
CORTE_WHISPER_MODEL=small
CORTE_FFMPEG_GPU=0

# Opcional si FFmpeg no está en PATH o usas otro Python:
# CORTE_FFMPEG_DIR=
# CORTE_PYTHON=python

# Carpeta donde se copian los vídeos terminados (por defecto Descargas/Vídeos):
# CORTE_EXPORT_DIR=
# Archivo de perfiles de marca (por defecto .corte-data/brands.json):
# CORTE_BRANDS_FILE=
# Python: se prueba CORTE_PYTHON, .venv, y después python/python3 según el sistema.
